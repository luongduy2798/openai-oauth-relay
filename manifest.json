{
  "manifest_version": 3,
  "name": "OpenAI OAuth Relay",
  "version": "1.1.1",
  "description": "Chuyển callback OAuth của Codex về dashboard đã được cấp quyền.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting", "webNavigation", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_title": "OpenAI OAuth Relay" },
  "background": { "service_worker": "background.js", "type": "module" }
}
